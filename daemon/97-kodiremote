#!/bin/sh
# Remote Bridge boot hook.
#
# Installed as a SYMLINK at /var/lib/webosbrew/init.d/97-kodiremote pointing
# back into the app package, so uninstalling the app disarms it: the link
# dangles, the [ -x ] test in webosbrew's hook runner fails, and nothing starts.
#
# Runs the daemon under its own transient systemd unit (in /run, tmpfs):
# processes started straight from an init.d hook live in ls-hubd.service's
# cgroup and get cleaned up at suspend transitions; a unit of our own doesn't,
# and Restart=always brings it back if anything kills it.

SELF=$(readlink -f "$0" 2>/dev/null)
case "$SELF" in
  */assets/97-kodiremote)
    DAEMON="${SELF%/97-kodiremote}/bridge.py" ;;
  *)
    DAEMON=/media/developer/apps/usr/palm/applications/com.github.dangerouslaser.kodiremote/assets/bridge.py ;;
esac
LOG=/home/root/kodiremote.log

[ -f "$DAEMON" ] || exit 0

# webOS 5 has Python 2, newer firmware Python 3.
PY=$(command -v python3 || command -v python || echo /usr/bin/python3)

if command -v systemctl >/dev/null 2>&1; then
  mkdir -p /run/systemd/system
  cat > /run/systemd/system/kodiremote.service <<UNIT
[Unit]
Description=Remote Bridge for Kodi (forward TV remote buttons to Kodi)
After=ls-hubd.service

[Service]
ExecStart=$PY -u $DAEMON
Restart=always
RestartSec=5
UNIT
  systemctl daemon-reload
  systemctl restart kodiremote.service
  echo "$(date) 97-kodiremote: unit started ($DAEMON)" >> $LOG
else
  pkill -f "kodiremote-loop" 2>/dev/null
  pkill -f "$DAEMON" 2>/dev/null
  # Restart loop in place of systemd's Restart=always (the daemon exits after an app update).
  nohup sh -c "while true; do \"$PY\" -u \"$DAEMON\"; sleep 5; done # kodiremote-loop" >/dev/null 2>&1 &
  echo "$(date) 97-kodiremote: no systemd, started in the background ($DAEMON)" >> $LOG
fi
